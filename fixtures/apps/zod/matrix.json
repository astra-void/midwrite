{
  "description": "Phase 16 Track A: zod differential matrix. Each case is a schema written with the zod API (`z`), the runtimes it exists in (`apis`: 3 = zod 3 API, 4 = zod 4 API), and inputs in the model's JSON value form ({\"$undefined\": true} is undefined, {\"$map\": []} an empty Map). crates/midwrite-analyzer/tests/zod.rs extracts every schema's parse/safeParse with Midwrite and compares the decision and the parsed output with fixtures/apps/zod/run.mjs on the pinned zod runtimes. Expected outcomes are never written here: the runtime is the oracle.",
  "constants": { "KINDS": ["student", "staff"], "LIMIT": 3 },
  "cases": [
    { "id": "enum_const_array", "apis": [3, 4], "schema": "z.object({ kind: z.enum(KINDS), filter: z.enum([\"all\", ...KINDS], \"pick one\").default(\"all\") })",
      "inputs": [{"kind": "staff"}, {"kind": "all"}, {"kind": "student", "filter": "staff"}, {"kind": "student", "filter": "none"}] },
    { "id": "object_required", "apis": [3, 4], "schema": "z.object({ name: z.string() })",
      "inputs": [{}, {"name": "a"}, {"name": {"$undefined": true}}, {"name": null}, {"name": "a", "extra": 1}, [], null, "x", {"name": 1}] },
    { "id": "object_strict_method", "apis": [3, 4], "schema": "z.object({ name: z.string() }).strict()",
      "inputs": [{"name": "a"}, {"name": "a", "extra": 1}, {"name": "a", "extra": {"$undefined": true}}, {}, [], {"name": "a", "extra": null}] },
    { "id": "strict_object", "apis": [3, 4], "schema": "z.strictObject({ name: z.string(), age: z.number().int().min(0) })",
      "inputs": [{"name": "a", "age": 3}, {"name": "a", "age": -1}, {"name": "a"}, {"name": "a", "age": 3, "x": 1}, {"name": "a", "age": 3, "x": {"$undefined": true}}, {"name": "a", "age": "3"}] },
    { "id": "passthrough", "apis": [3, 4], "schema": "z.object({ a: z.string() }).passthrough()",
      "inputs": [{"a": "x"}, {"a": "x", "b": 1, "c": null}, {"b": 1}, {"a": "x", "u": {"$undefined": true}}] },
    { "id": "loose_object", "apis": [4], "schema": "z.looseObject({ a: z.string().trim() })",
      "inputs": [{"a": " x "}, {"a": "x", "b": [1, 2]}, {"b": 1}] },
    { "id": "strip_method", "apis": [3, 4], "schema": "z.object({ a: z.string() }).strip()",
      "inputs": [{"a": "x", "b": 1}, {"b": 1}] },
    { "id": "strict_then_passthrough", "apis": [3, 4], "schema": "z.object({ a: z.string() }).strict().passthrough()",
      "inputs": [{"a": "x", "b": 1}] },
    { "id": "passthrough_then_strict", "apis": [3, 4], "schema": "z.object({ a: z.string() }).passthrough().strict()",
      "inputs": [{"a": "x", "b": 1}, {"a": "x"}] },
    { "id": "optional_field", "apis": [3, 4], "schema": "z.object({ a: z.string().optional() })",
      "inputs": [{}, {"a": {"$undefined": true}}, {"a": null}, {"a": "x"}, {"a": 1}] },
    { "id": "nullable_field", "apis": [3, 4], "schema": "z.object({ a: z.string().nullable() })",
      "inputs": [{}, {"a": {"$undefined": true}}, {"a": null}, {"a": "x"}] },
    { "id": "nullish_field", "apis": [3, 4], "schema": "z.object({ a: z.string().trim().nullish() })",
      "inputs": [{}, {"a": {"$undefined": true}}, {"a": null}, {"a": " x "}, {"a": 2}] },
    { "id": "optional_nullable_order", "apis": [3, 4], "schema": "z.object({ a: z.string().optional().nullable() })",
      "inputs": [{}, {"a": {"$undefined": true}}, {"a": null}, {"a": "x"}] },
    { "id": "default_field", "apis": [3, 4], "schema": "z.object({ a: z.string().default(\"d\") })",
      "inputs": [{}, {"a": {"$undefined": true}}, {"a": null}, {"a": "x"}, {"a": 3}] },
    { "id": "default_not_valid", "apis": [3, 4], "schema": "z.object({ a: z.string().min(5).default(\"d\") })",
      "inputs": [{}, {"a": "hello!"}, {"a": "hi"}] },
    { "id": "default_transformed", "apis": [3, 4], "schema": "z.object({ a: z.string().trim().toUpperCase().default(\"  d \") })",
      "inputs": [{}, {"a": " x "}, {"a": {"$undefined": true}}] },
    { "id": "optional_of_default", "apis": [3, 4], "schema": "z.object({ a: z.string().default(\"d\").optional() })",
      "inputs": [{}, {"a": {"$undefined": true}}, {"a": "x"}] },
    { "id": "default_of_optional", "apis": [3, 4], "schema": "z.object({ a: z.string().optional().default(\"d\") })",
      "inputs": [{}, {"a": {"$undefined": true}}, {"a": "x"}] },
    { "id": "nullable_default", "apis": [3, 4], "schema": "z.object({ a: z.string().nullable().default(\"d\") })",
      "inputs": [{}, {"a": null}, {"a": "x"}] },
    { "id": "default_null", "apis": [3, 4], "schema": "z.object({ a: z.string().nullable().default(null) })",
      "inputs": [{}, {"a": "x"}, {"a": null}] },
    { "id": "default_number", "apis": [3, 4], "schema": "z.object({ n: z.number().int().min(1).default(1), b: z.boolean().default(false) })",
      "inputs": [{}, {"n": 4, "b": true}, {"n": 0}] },
    { "id": "enum", "apis": [3, 4], "schema": "z.enum([\"admin\", \"member\"])",
      "inputs": ["admin", "member", "x", 1, {"$undefined": true}, null] },
    { "id": "enum_default_field", "apis": [3, 4], "schema": "z.object({ role: z.enum([\"admin\", \"member\"]).default(\"member\") })",
      "inputs": [{}, {"role": "admin"}, {"role": "owner"}] },
    { "id": "literals", "apis": [3, 4], "schema": "z.object({ s: z.literal(\"a\"), n: z.literal(3), b: z.literal(true) })",
      "inputs": [{"s": "a", "n": 3, "b": true}, {"s": "b", "n": 3, "b": true}, {"s": "a", "n": 4, "b": true}, {"s": "a", "n": 3, "b": false}, {"s": "a", "n": 3}] },
    { "id": "uuid_method", "apis": [3, 4], "schema": "z.string().uuid()",
      "inputs": ["123e4567-e89b-42d3-a456-426614174000", "123E4567-E89B-42D3-A456-426614174000", "00000000-0000-0000-0000-000000000000", "ffffffff-ffff-ffff-ffff-ffffffffffff", "FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF", "123e4567-e89b-02d3-a456-426614174000", "123e4567-e89b-92d3-a456-426614174000", "123e4567-e89b-42d3-c456-426614174000", "0190a8b2-3c4d-7e5f-8a6b-1c2d3e4f5a6b", "123e4567-e89b-42d3-a456-42661417400", "{123e4567-e89b-42d3-a456-426614174000}", "123e4567-e89b-42d3-a456-42661417400g", "", 5] },
    { "id": "uuid_function", "apis": [4], "schema": "z.uuid()",
      "inputs": ["123e4567-e89b-42d3-a456-426614174000", "00000000-0000-0000-0000-000000000000", "123e4567-e89b-02d3-a456-426614174000", "0190a8b2-3c4d-7e5f-8a6b-1c2d3e4f5a6b"] },
    { "id": "email_method", "apis": [3, 4], "schema": "z.string().email()",
      "inputs": ["a@b.co", "a.b@ex.co", "a..b@ex.co", ".a@ex.co", "a.@ex.co", "a'@ex.co", "o'neil@ex.co", "a@ex", "A@EX.CO", "a+b@sub.ex.co", "a@-ex.co", "a@ex-.co", "é@ex.co", "a b@ex.co", "a@ex.c", "a@ex.co.", "a@@ex.co", "_@ex.co", "-@ex.co"] },
    { "id": "email_function", "apis": [4], "schema": "z.email()",
      "inputs": ["a@b.co", "a..b@ex.co", "a@ex"] },
    { "id": "regex_classes", "apis": [3, 4], "schema": "z.string().regex(/^[a-z]{2,4}-\\d+$/)",
      "inputs": ["ab-1", "abcd-123", "a-1", "abcde-1", "AB-1", "ab-", "ab-1\n"] },
    { "id": "regex_case_insensitive", "apis": [3, 4], "schema": "z.string().regex(/^abc(?:-x)?$/i)",
      "inputs": ["abc", "ABC", "aBc-X", "abcd", "ſbc"] },
    { "id": "regex_word_alternation", "apis": [3, 4], "schema": "z.string().regex(/^(?:\\w+|\\s*)$/)",
      "inputs": ["abc_1", "   ", "", "a b", "é"] },
    { "id": "regex_lookahead", "apis": [3, 4], "schema": "z.string().regex(/^(?!admin$)[a-z]+$/)",
      "inputs": ["admin", "admins", "user", "Admin"] },
    { "id": "string_transforms", "apis": [3, 4], "schema": "z.string().trim().toLowerCase().min(1).max(5)",
      "inputs": [" AbC ", "   ", "ABCDEFG", "\tx ", "﻿q"] },
    { "id": "string_affixes", "apis": [3, 4], "schema": "z.string().startsWith(\"ab\").endsWith(\"yz\").includes(\"m\").length(6)",
      "inputs": ["abmxyz", "abxxyz", "abmmyz", "ab-m-yz"] },
    { "id": "number_checks", "apis": [3, 4], "schema": "z.number().int().positive().max(10)",
      "inputs": [1, 0, 10, 11, -3, "1", true] },
    { "id": "number_bounds", "apis": [3, 4], "schema": "z.number().gte(-2).lt(3).nonpositive()",
      "inputs": [-2, -3, 0, 1] },
    { "id": "boolean", "apis": [3, 4], "schema": "z.boolean()",
      "inputs": [true, false, "true", 1, null] },
    { "id": "array_strings", "apis": [3, 4], "schema": "z.array(z.string()).min(1).max(2)",
      "inputs": [[], ["a"], ["a", "b", "c"], [1], "a", {}, ["a", null]] },
    { "id": "array_enum_nonempty", "apis": [3, 4], "schema": "z.array(z.enum([\"a\", \"b\"])).nonempty()",
      "inputs": [[], ["a", "b", "a"], ["c"]] },
    { "id": "array_uuid", "apis": [3, 4], "schema": "z.array(z.string().uuid())",
      "inputs": [[], ["123e4567-e89b-42d3-a456-426614174000"], ["123e4567-e89b-02d3-a456-426614174000"]] },
    { "id": "array_length", "apis": [3, 4], "schema": "z.array(z.number()).length(2)",
      "inputs": [[1, 2], [1], [1, 2, 3], [1, "2"]] },
    { "id": "array_optional_items", "apis": [3, 4], "schema": "z.array(z.string().optional())",
      "inputs": [[{"$undefined": true}, "a"], [null]] },
    { "id": "array_method_form", "apis": [3, 4], "schema": "z.string().array().max(1)",
      "inputs": [["a"], ["a", "b"]] },
    { "id": "array_min_twice", "apis": [3, 4], "schema": "z.array(z.string()).min(2).min(1)",
      "inputs": [["a"], ["a", "b"], []] },
    { "id": "array_of_objects", "apis": [3, 4], "schema": "z.object({ items: z.array(z.strictObject({ kind: z.enum(KINDS), id: z.string().uuid(), note: z.string().trim().optional() })).min(1).max(3) }).strict()",
      "inputs": [{"items": [{"kind": "staff", "id": "123e4567-e89b-42d3-a456-426614174000"}]}, {"items": [{"kind": "staff", "id": "123e4567-e89b-42d3-a456-426614174000", "note": " n "}, {"kind": "student", "id": "123e4567-e89b-42d3-a456-426614174001", "note": {"$undefined": true}}]}, {"items": [{"kind": "staff", "id": "123e4567-e89b-42d3-a456-426614174000", "x": 1}]}, {"items": []}, {"items": [{"kind": "staff"}]}] },
    { "id": "messages", "apis": [3, 4], "schema": "z.object({ s: z.string({ message: \"text\" }).max(LIMIT, `at most ${LIMIT}`), n: z.number({ invalid_type_error: \"num\" }).int(\"whole\"), b: z.boolean({ description: \"flag\" }) })",
      "inputs": [{"s": "abc", "n": 1, "b": true}, {"s": "abcd", "n": 1, "b": true}, {"s": "a", "n": "1", "b": true}] },
    { "id": "array_transformed", "apis": [3, 4], "schema": "z.array(z.string().trim().toLowerCase())",
      "inputs": [[" A ", "b"], [], [1]] },
    { "id": "array_optional", "apis": [3, 4], "schema": "z.object({ tags: z.array(z.string()).optional() })",
      "inputs": [{}, {"tags": []}, {"tags": ["a"]}, {"tags": null}] },
    { "id": "nested_strict", "apis": [3, 4], "schema": "z.object({ o: z.object({ a: z.string() }).strict() })",
      "inputs": [{"o": {"a": "x"}}, {"o": {"a": "x", "b": 2}}, {"o": {"a": "x"}, "b": 2}, {}] },
    { "id": "nested_optional_object", "apis": [3, 4], "schema": "z.object({ o: z.object({ a: z.string().default(\"x\") }).optional() })",
      "inputs": [{}, {"o": {}}, {"o": {"$undefined": true}}, {"o": {"a": "y", "z": 1}}, {"o": null}] },
    { "id": "nested_strict_object_input", "apis": [3, 4], "schema": "z.strictObject({ user: z.strictObject({ id: z.string().uuid(), role: z.enum([\"admin\", \"member\"]) }), note: z.string().max(3).optional() })",
      "inputs": [{"user": {"id": "123e4567-e89b-42d3-a456-426614174000", "role": "admin"}}, {"user": {"id": "123e4567-e89b-42d3-a456-426614174000", "role": "admin"}, "note": "abc"}, {"user": {"id": "123e4567-e89b-42d3-a456-426614174000", "role": "admin", "x": 1}}, {"user": {"id": "nope", "role": "admin"}}, {"user": {"id": "123e4567-e89b-42d3-a456-426614174000", "role": "admin"}, "note": "abcd"}] },
