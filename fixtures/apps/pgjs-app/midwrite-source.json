{
  "schemaVersion": 1,
  "kind": "midwrite.source-harness",
  "harness": "pgjs-app",
  "description": "Runs the postgres-js application's original actions (client created at module load from POSTGRES_URL) against a disposable PostgreSQL database, coordinating postgres-js 3.4.5.",
  "command": [
    "node",
    "--enable-source-maps",
    "dist/verify/harness.js"
  ],
  "runtime": {
    "node": ">=22",
    "postgres": "3.4.5"
  },
  "schema": [
    "drizzle/0000_init.sql"
  ],
  "network": "deny",
  "timeoutMs": 30000,
  "entries": {
    "inviteTeamMember": {
      "selector": "src/app/actions.ts#inviteTeamMember/arg[1]"
    },
    "acceptInvitation": {
      "selector": "src/app/actions.ts#acceptInvitation/arg[1]"
    },
    "payOrder": {
      "selector": "src/app/checkout.ts#payOrder"
    },
    "reserveStock": {
      "selector": "src/app/inventory.ts#reserveStock"
    }
  }
}