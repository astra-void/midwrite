{
  "schemaVersion": 1,
  "name": "reserve-race",
  "description": "Phase 13 Track E: two concurrent upserts that take a free handle over.",
  "extraction": {
    "root": "..",
    "schema": "src/db/schema.ts"
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "handles"
      }
    ],
    "initialState": {
      "handles": [
        {
          "handle": "x",
          "owner": null
        }
      ]
    }
  },
  "actors": [
    {
      "name": "alice",
      "entry": {
        "selector": "src/services/upserts.ts#reserveHandle"
      },
      "arguments": [
        "x",
        "alice"
      ]
    },
    {
      "name": "bob",
      "entry": {
        "selector": "src/services/upserts.ts#reserveHandle"
      },
      "arguments": [
        "x",
        "bob"
      ]
    }
  ],
  "invariants": [
    {
      "name": "at-most-one-caller-told-it-got-the-handle",
      "description": "[USER_DECLARED] At most one caller is told it reserved the handle.",
      "assert": {
        "le": [
          {
            "actors": {
              "outcome": "ok",
              "returned": true
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../midwrite-source.json",
    "actors": {
      "alice": {
        "entry": "reserveHandle",
        "input": {
          "handle": "x",
          "owner": "alice"
        }
      },
      "bob": {
        "entry": "reserveHandle",
        "input": {
          "handle": "x",
          "owner": "bob"
        }
      }
    }
  }
}