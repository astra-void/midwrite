{
  "schemaVersion": 1,
  "name": "welcome-once",
  "description": "Phase 14 Track D, safe counterpart: the UPDATE carries `isNull(welcomedAt)`; its row count decides.",
  "features": ["timestamps"],
  "extraction": { "root": "..", "schema": "src/db/schema.ts" },
  "database": {
    "isolation": "read-committed",
    "tables": [{ "from": "users" }],
    "initialState": { "users": [{ "id": 9, "email": "u@x", "welcomedAt": null, "updatedAt": null }] }
  },
  "actors": [
    { "name": "job1", "entry": { "selector": "src/services/users.ts#welcomeOnce" }, "arguments": [9] },
    { "name": "job2", "entry": { "selector": "src/services/users.ts#welcomeOnce" }, "arguments": [9] }
  ],
  "invariants": [
    {
      "name": "welcomed-at-most-once",
      "description": "[USER_DECLARED] At most one delivery reports that it welcomed the user.",
      "assert": { "le": [{ "actors": { "outcome": "ok", "returned": true } }, 1] }
    }
  ]
}
