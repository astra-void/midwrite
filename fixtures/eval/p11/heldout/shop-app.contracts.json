{
  "schemaVersion": 1,
  "kind": "midwrite.contracts",
  "description": "Contracts for fixtures/apps/shop-app, transcribed from what its Phase 8 hand-authored scenarios already declared (externals, channel deduplication, retries, delivery, the transaction-retry helper). Nothing else is declared: no invariant.",
  "externals": [
    { "callee": "chargeCard", "channel": "card-charge", "keyArgument": 1, "dedup": "byKey" },
    { "callee": "notifyWarehouse", "channel": "warehouse", "dedup": "none" },
    { "callee": "publishEvent", "channel": "order-events", "keyArgument": 1, "dedup": "none" },
    { "callee": "sendReceiptEmail", "channel": "receipt-email", "dedup": "none" }
  ],
  "entries": {
    "src/app/checkout.ts#payOrder": { "retry": "on-crash" },
    "src/app/checkout.ts#payOrderIdempotent": { "retry": "on-crash" },
    "src/app/jobs.ts#sendReceipt": { "delivery": "at-least-once" },
    "src/app/jobs.ts#sendReceiptOnce": { "delivery": "at-least-once" },
    "src/app/shipping.ts#relayOutbox": { "retry": "on-crash" }
  },
  "transactionHelpers": [
    { "callee": "withTransactionRetry", "callbackArgument": 0, "optionsArgument": 1, "attempts": 1 }
  ]
}
