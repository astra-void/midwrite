{
  "schemaVersion": 1,
  "name": "inventory-retry-duplicate-notice",
  "description": "FIRST-PARTY APPLICATION: two concurrent reservations under REPEATABLE READ; PostgreSQL aborts the second with 40001 and the application's withTransactionRetry re-runs it in a fresh transaction. The warehouse notification inside the transaction is NOT undone by the rollback: one reservation, two notices.",
  "extraction": {
    "root": "../../apps/shop-app",
    "externals": [
      {
        "callee": "notifyWarehouse",
        "channel": "warehouse"
      }
    ],
    "transactionRetries": [
      {
        "callee": "withTransactionRetry",
        "callbackArgument": 0,
        "optionsArgument": 1
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "warehouse": {
      "dedup": "none"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "products",
        "columns": [
          "id",
          "sku",
          "stock"
        ]
      },
      {
        "from": "reservations",
        "columns": [
          "id",
          "productId",
          "quantity"
        ]
      }
    ],
    "initialState": {
      "products": [
        {
          "id": 1,
          "sku": "SKU-1",
          "stock": 10
        }
      ],
      "reservations": []
    }
  },
  "actors": [
    {
      "name": "R1",
      "entry": {
        "selector": "src/app/inventory.ts#reserveStock",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "productId": 1,
          "quantity": 2
        }
      ],
      "description": "a reservation request"
    },
    {
      "name": "R2",
      "entry": {
        "selector": "src/app/inventory.ts#reserveStock",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "productId": 1,
          "quantity": 2
        }
      ],
      "description": "a reservation request"
    }
  ],
  "bounds": {
    "maxSteps": 60,
    "maxRetries": 2
  },
  "invariants": [
    {
      "name": "one-notice-per-reservation",
      "when": "final",
      "description": "the warehouse is notified once per committed reservation",
      "assert": {
        "le": [
          {
            "externals": {
              "channel": "warehouse"
            }
          },
          {
            "count": {
              "table": "reservations"
            }
          }
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../../apps/shop-app/midwrite-source.json",
    "actors": {
      "R1": {
        "entry": "reserveStock",
        "input": {
          "productId": 1,
          "quantity": 2
        }
      },
      "R2": {
        "entry": "reserveStock",
        "input": {
          "productId": 1,
          "quantity": 2
        }
      }
    }
  }
}