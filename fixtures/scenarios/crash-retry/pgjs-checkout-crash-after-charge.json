{
  "schemaVersion": 1,
  "name": "pgjs-checkout-crash-after-charge",
  "description": "FIRST-PARTY APPLICATION ON POSTGRES-JS (fixtures/apps/pgjs-app): the provider confirms the charge, the server process crashes before the order is marked paid (so before the response), the client retries the same request. The provider deduplicates charges by idempotency key (DECLARED contract of the test double); this checkout sends none.",
  "extraction": {
    "root": "../../apps/pgjs-app",
    "externals": [
      {
        "callee": "chargeCard",
        "channel": "card-charge",
        "keyArgument": 1
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "card-charge": {
      "dedup": "byKey"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "orders",
        "columns": [
          "id",
          "customerEmail",
          "amount",
          "status"
        ]
      },
      {
        "from": "paymentAttempts",
        "columns": [
          "id",
          "orderId",
          "amount"
        ]
      }
    ],
    "initialState": {
      "orders": [
        {
          "id": 1,
          "customerEmail": "c@example.com",
          "amount": 500,
          "status": "unpaid"
        }
      ],
      "payment_attempts": []
    }
  },
  "actors": [
    {
      "name": "Client",
      "entry": {
        "selector": "src/app/checkout.ts#payOrder",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-1",
          "orderId": 1
        }
      ],
      "retry": {
        "trigger": "onCrash"
      },
      "description": "a client that submits the same request again when the server does not answer"
    }
  ],
  "bounds": {
    "maxSteps": 40,
    "maxCrashes": 1,
    "maxRetries": 1
  },
  "invariants": [
    {
      "name": "charged-at-most-once",
      "when": "final",
      "description": "one checkout request causes at most one effective card charge",
      "assert": {
        "le": [
          {
            "externals": {
              "channel": "card-charge"
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../../apps/pgjs-app/midwrite-source.json",
    "actors": {
      "Client": {
        "entry": "payOrder",
        "input": {
          "requestId": "req-1",
          "orderId": 1
        }
      }
    }
  }
}