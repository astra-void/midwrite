{
  "schemaVersion": 1,
  "name": "job-claimed-effect-concurrent",
  "description": "FIRST-PARTY APPLICATION: two consumers receive the same job concurrently; the unique claim row lets only one send the receipt.",
  "extraction": {
    "root": "../../apps/shop-app",
    "externals": [
      {
        "callee": "publishEvent",
        "channel": "order-events",
        "keyArgument": 1
      },
      {
        "callee": "sendReceiptEmail",
        "channel": "receipt-email"
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "order-events": {
      "dedup": "none"
    },
    "receipt-email": {
      "dedup": "none"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "jobs",
        "columns": [
          "id",
          "kind",
          "orderId",
          "status"
        ]
      },
      {
        "from": "jobEffects",
        "columns": [
          "id",
          "jobId",
          "effect"
        ]
      }
    ],
    "initialState": {
      "jobs": [
        {
          "id": 7,
          "kind": "receipt",
          "orderId": 1,
          "status": "queued"
        }
      ],
      "job_effects": []
    }
  },
  "actors": [
    {
      "name": "WorkerA",
      "entry": {
        "selector": "src/app/jobs.ts#sendReceiptOnce",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "jobId": 7
        }
      ],
      "description": "a second consumer that received the same job"
    },
    {
      "name": "WorkerB",
      "entry": {
        "selector": "src/app/jobs.ts#sendReceiptOnce",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "jobId": 7
        }
      ],
      "description": "a second consumer that received the same job"
    }
  ],
  "bounds": {
    "maxSteps": 30
  },
  "invariants": [
    {
      "name": "receipt-sent-at-most-once",
      "when": "final",
      "description": "a job's receipt e-mail is sent at most once",
      "assert": {
        "le": [
          {
            "externals": {
              "channel": "receipt-email"
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../../apps/shop-app/midwrite-source.json",
    "actors": {
      "WorkerA": {
        "entry": "sendReceiptOnce",
        "input": {
          "jobId": 7
        }
      },
      "WorkerB": {
        "entry": "sendReceiptOnce",
        "input": {
          "jobId": 7
        }
      }
    },
    "recoveryProbe": {
      "require": [
        "statement:WorkerA",
        "statement:WorkerB",
        "external:receipt-email"
      ]
    }
  }
}