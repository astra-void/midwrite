{
  "schemaVersion": 1,
  "name": "ledger-settle-update-not-reached",
  "description": "FIRST-PARTY APPLICATION: two autocommit writes (ledger row, then the order status). The process is killed with the second write in flight; no retry is declared. The durable state is what the server did, not what the client knew.",
  "extraction": {
    "root": "../../apps/ledger-app",
    "externals": [
      {
        "callee": "publishConfirmation",
        "channel": "confirmation"
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "confirmation": {
      "dedup": "none"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "orders",
        "columns": [
          "id",
          "status"
        ]
      },
      {
        "from": "ledger",
        "columns": [
          "id",
          "requestId",
          "orderId",
          "amount"
        ]
      }
    ],
    "initialState": {
      "orders": [
        {
          "id": 1,
          "status": "unpaid"
        }
      ],
      "ledger": []
    }
  },
  "actors": [
    {
      "name": "Client",
      "entry": {
        "selector": "src/app/payments.ts#settleOrder",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      ],
      "description": "a request handler"
    }
  ],
  "bounds": {
    "maxSteps": 30,
    "maxCrashes": 1,
    "maxInFlight": 1,
    "crashPolicy": "in-flight-only"
  },
  "invariants": [
    {
      "name": "paid-order-has-a-ledger-row",
      "when": "final",
      "description": "an order marked paid has its payment in the ledger",
      "assert": {
        "implies": [
          {
            "eq": [
              {
                "count": {
                  "table": "orders",
                  "where": {
                    "status": "paid"
                  }
                }
              },
              1
            ]
          },
          {
            "ge": [
              {
                "count": {
                  "table": "ledger",
                  "where": {}
                }
              },
              1
            ]
          }
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../../apps/ledger-app/midwrite-source.json",
    "actors": {
      "Client": {
        "entry": "settleOrder",
        "input": {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      }
    },
    "recoveryProbe": {
      "require": [
        "statement:Client",
        "crash:Client"
      ]
    }
  }
}
