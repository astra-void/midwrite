{
  "schemaVersion": 1,
  "name": "ledger-autocommit-blind-in-flight",
  "description": "FIRST-PARTY APPLICATION: an autocommit INSERT is in flight when the process is killed; the client sends the request again.",
  "extraction": {
    "root": "../../apps/ledger-app",
    "externals": [
      {
        "callee": "publishConfirmation",
        "channel": "confirmation"
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "confirmation": {
      "dedup": "none"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "payments",
        "columns": [
          "id",
          "requestId",
          "orderId",
          "amount"
        ]
      }
    ],
    "initialState": {
      "payments": []
    }
  },
  "actors": [
    {
      "name": "Client",
      "entry": {
        "selector": "src/app/payments.ts#recordPaymentAutocommit",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      ],
      "retry": {
        "trigger": "onCrash"
      },
      "description": "a client that submits the same payment again when it gets no answer"
    }
  ],
  "bounds": {
    "maxSteps": 40,
    "maxCrashes": 1,
    "maxRetries": 1,
    "maxInFlight": 1,
    "crashPolicy": "in-flight-only"
  },
  "invariants": [
    {
      "name": "recorded-at-most-once",
      "when": "final",
      "description": "one logical payment (one request id) is recorded at most once",
      "assert": {
        "le": [
          {
            "count": {
              "table": "payments",
              "where": {}
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../../apps/ledger-app/midwrite-source.json",
    "actors": {
      "Client": {
        "entry": "recordPaymentAutocommit",
        "input": {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      }
    }
  }
}
