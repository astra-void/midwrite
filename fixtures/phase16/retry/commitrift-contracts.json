{
  "schemaVersion": 1,
  "kind": "commitrift.contracts",
  "description": "What the Phase 16 retry application's source cannot say: its business rules, and how the authorized harness calls each entry.",
  "invariants": [
    {
      "name": "one-order-per-request",
      "description": "One client request records at most one order.",
      "entries": ["src/services/orders.ts#placeOrder", "src/app/api/orders/route.ts#POST"],
      "property": { "template": "atMostOne", "table": "orders", "key": ["requestId"] }
    },
    {
      "name": "balance-non-negative",
      "description": "An account's balance never goes below zero.",
      "entries": ["src/services/orders.ts#withdraw"],
      "property": { "template": "nonNegative", "table": "accounts", "column": "balance" }
    }
  ],
  "harness": {
    "manifest": "commitrift-source.json",
    "entries": {
      "src/services/orders.ts#placeOrder": {
        "entry": "placeOrder",
        "input": { "requestId": "$arg0", "customerId": "$arg1", "amount": "$arg2" }
      },
      "src/services/orders.ts#recordPayment": {
        "entry": "recordPayment",
        "input": { "idempotencyKey": "$arg0", "orderId": "$arg1", "amount": "$arg2" }
      },
      "src/services/orders.ts#withdraw": {
        "entry": "withdraw",
        "input": { "accountId": "$arg0", "amount": "$arg1" }
      },
      "src/app/api/orders/route.ts#POST": {
        "entry": "POST",
        "input": { "body": "$arg0" }
      }
    }
  }
}
