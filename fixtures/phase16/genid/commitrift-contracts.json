{
  "schemaVersion": 1,
  "kind": "commitrift.contracts",
  "description": "What the Phase 16 generated-identifier application's source cannot say: that project-creation clients resubmit when they get no response, and what callers are promised about the generated values they are told. The page-view counter, the team-membership and the insight code declare nothing here (their properties are the templates of docs/phase16/GENERATED-ID-INVARIANTS.md, which a test loads separately).",
  "entries": {
    "src/services/projects.ts#createProject": {
      "retry": "on-crash",
      "description": "POST /projects with a client request id; the client resubmits the same request when it gets no response."
    },
    "src/services/projects.ts#createProjectSafe": {
      "retry": "on-crash",
      "description": "As createProject."
    }
  },
  "invariants": [
    {
      "name": "share-token-told-is-stored",
      "description": "Every caller that was given the link's share token was given the stored one: the link it hands out works.",
      "entries": [
        "src/services/share-links.ts#ensureShareToken",
        "src/services/share-links.ts#ensureShareTokenAtomic"
      ],
      "property": {
        "template": "formula",
        "assert": {
          "forEachActor": {
            "assert": {
              "same": [
                { "returned": { "path": "token" } },
                {
                  "rowMatching": {
                    "table": "share_links",
                    "match": { "id": { "argument": { "path": "linkId" } } },
                    "column": "token"
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "returned-project-id-is-the-request-row",
      "description": "The id a project creation returns is the generated id of its request's project row (whichever attempt or submission created that row).",
      "entries": [
        "src/services/projects.ts#createProject",
        "src/services/projects.ts#createProjectSafe"
      ],
      "property": {
        "template": "formula",
        "assert": {
          "forEachActor": {
            "assert": {
              "and": [
                { "generatedBy": { "value": { "returned": { "path": "id" } }, "generator": "call" } },
                {
                  "sameGenerated": [
                    { "returned": { "path": "id" } },
                    {
                      "rowMatching": {
                        "table": "projects",
                        "match": { "requestId": { "argument": { "path": "requestId" } } },
                        "column": "id"
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "invite-read-your-writes",
      "description": "The id an invitation call returns is the generated id of the invitation that call created (read-your-writes: the caller sees its own write).",
      "entries": [
        "src/services/invites.ts#createInvite",
        "src/services/invites.ts#createInvitePrimary"
      ],
      "property": {
        "template": "formula",
        "assert": {
          "forEachActor": {
            "assert": {
              "and": [
                {
                  "generatedBy": {
                    "value": { "returned": { "path": "id" } },
                    "by": "self",
                    "generator": { "column": "invites.id" }
                  }
                },
                {
                  "eq": [
                    {
                      "countMatching": {
                        "table": "invites",
                        "match": { "id": { "returned": { "path": "id" } } },
                        "insertedBy": "self"
                      }
                    },
                    1
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
