{
  "schemaVersion": 1,
  "name": "claim-atomic",
  "description": "Phase 13 vertical slice 2, safe counterpart: the conditional UPDATE's row count decides.",
  "extraction": {
    "root": "..",
    "schema": "src/db/schema.ts"
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "tasks"
      }
    ],
    "initialState": {
      "tasks": [
        {
          "id": 7,
          "title": "write the report",
          "assignee": null
        }
      ]
    }
  },
  "actors": [
    {
      "name": "alice",
      "entry": {
        "selector": "src/services/tasks.ts#claimTaskAtomic"
      },
      "arguments": [
        7,
        "alice"
      ]
    },
    {
      "name": "bob",
      "entry": {
        "selector": "src/services/tasks.ts#claimTaskAtomic"
      },
      "arguments": [
        7,
        "bob"
      ]
    }
  ],
  "invariants": [
    {
      "name": "at-most-one-caller-told-it-claimed",
      "description": "[USER_DECLARED] At most one caller is told it claimed the task (the callers' observed outcome, not the database state).",
      "assert": {
        "le": [
          {
            "actors": {
              "outcome": "ok",
              "returned": true
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../midwrite-source.json",
    "actors": {
      "alice": {
        "entry": "claimTaskAtomic",
        "input": {
          "taskId": 7,
          "who": "alice"
        }
      },
      "bob": {
        "entry": "claimTaskAtomic",
        "input": {
          "taskId": 7,
          "who": "bob"
        }
      }
    }
  }
}
