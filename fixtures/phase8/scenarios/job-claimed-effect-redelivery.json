{
  "schemaVersion": 1,
  "name": "job-claimed-effect-redelivery",
  "description": "FIRST-PARTY APPLICATION: the consumer claims the effect with a unique row before sending; a crash after the e-mail and before the acknowledgement, then redelivery. At most one receipt (the claim is atomic in PostgreSQL); a crash between claim and e-mail loses the receipt instead (at-most-once, not exactly-once).",
  "extraction": {
    "root": "../shop-app",
    "externals": [
      {
        "callee": "publishEvent",
        "channel": "order-events",
        "keyArgument": 1
      },
      {
        "callee": "sendReceiptEmail",
        "channel": "receipt-email"
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "order-events": {
      "dedup": "none"
    },
    "receipt-email": {
      "dedup": "none"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "jobs",
        "columns": [
          "id",
          "kind",
          "orderId",
          "status"
        ]
      },
      {
        "from": "jobEffects",
        "columns": [
          "id",
          "jobId",
          "effect"
        ]
      }
    ],
    "initialState": {
      "jobs": [
        {
          "id": 7,
          "kind": "receipt",
          "orderId": 1,
          "status": "queued"
        }
      ],
      "job_effects": []
    }
  },
  "actors": [
    {
      "name": "Worker",
      "entry": {
        "selector": "src/app/jobs.ts#sendReceiptOnce",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "jobId": 7
        }
      ],
      "retry": {
        "trigger": "atLeastOnce"
      },
      "description": "a queue consumer; the queue redelivers an unacknowledged job (declared at-least-once)"
    }
  ],
  "bounds": {
    "maxSteps": 30,
    "maxCrashes": 1,
    "maxRetries": 1
  },
  "invariants": [
    {
      "name": "receipt-sent-at-most-once",
      "when": "final",
      "description": "a job's receipt e-mail is sent at most once",
      "assert": {
        "le": [
          {
            "externals": {
              "channel": "receipt-email"
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../shop-app/midwrite-source.json",
    "actors": {
      "Worker": {
        "entry": "sendReceiptOnce",
        "input": {
          "jobId": 7
        }
      }
    },
    "recoveryProbe": {
      "require": [
        "external:receipt-email",
        "crash:Worker",
        "retry:Worker"
      ]
    }
  }
}