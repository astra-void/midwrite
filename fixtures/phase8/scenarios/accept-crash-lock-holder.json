{
  "schemaVersion": 1,
  "name": "accept-crash-lock-holder",
  "description": "FIRST-PARTY APPLICATION (phase7 team-app): Accept1 holds the invitation's row lock, Accept2 waits for it; Accept1's process is killed before COMMIT. PostgreSQL rolls Accept1 back and releases the lock; Accept2 proceeds and commits.",
  "extraction": {
    "root": "../../phase7/team-app",
    "tables": {
      "teamMembers": "team_members",
      "activityLogs": "activity_logs"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "name": "users",
        "columns": [
          {
            "name": "id",
            "type": "int",
            "notNull": true,
            "default": {
              "sequence": {}
            }
          },
          {
            "name": "email",
            "type": "text",
            "notNull": true
          },
          {
            "name": "passwordHash",
            "type": "text",
            "notNull": true,
            "sqlName": "password_hash"
          }
        ],
        "primaryKey": [
          "id"
        ],
        "unique": [
          [
            "email"
          ]
        ]
      },
      {
        "name": "teams",
        "columns": [
          {
            "name": "id",
            "type": "int",
            "notNull": true,
            "default": {
              "sequence": {}
            }
          },
          {
            "name": "name",
            "type": "text",
            "notNull": true
          }
        ],
        "primaryKey": [
          "id"
        ]
      },
      {
        "name": "team_members",
        "columns": [
          {
            "name": "id",
            "type": "int",
            "notNull": true,
            "default": {
              "sequence": {}
            }
          },
          {
            "name": "userId",
            "type": "int",
            "notNull": true,
            "sqlName": "user_id"
          },
          {
            "name": "teamId",
            "type": "int",
            "notNull": true,
            "sqlName": "team_id"
          },
          {
            "name": "role",
            "type": "text",
            "notNull": true
          }
        ],
        "primaryKey": [
          "id"
        ]
      },
      {
        "name": "invitations",
        "columns": [
          {
            "name": "id",
            "type": "int",
            "notNull": true,
            "default": {
              "sequence": {}
            }
          },
          {
            "name": "teamId",
            "type": "int",
            "notNull": true,
            "sqlName": "team_id"
          },
          {
            "name": "email",
            "type": "text",
            "notNull": true
          },
          {
            "name": "role",
            "type": "text",
            "notNull": true
          },
          {
            "name": "invitedBy",
            "type": "int",
            "notNull": true,
            "sqlName": "invited_by"
          },
          {
            "name": "status",
            "type": "text",
            "notNull": true,
            "default": {
              "value": "pending"
            }
          }
        ],
        "primaryKey": [
          "id"
        ]
      },
      {
        "name": "activity_logs",
        "columns": [
          {
            "name": "id",
            "type": "int",
            "notNull": true,
            "default": {
              "sequence": {}
            }
          },
          {
            "name": "teamId",
            "type": "int",
            "notNull": true,
            "sqlName": "team_id"
          },
          {
            "name": "userId",
            "type": "int",
            "sqlName": "user_id"
          },
          {
            "name": "action",
            "type": "text",
            "notNull": true
          },
          {
            "name": "ipAddress",
            "type": "text",
            "sqlName": "ip_address"
          }
        ],
        "primaryKey": [
          "id"
        ]
      }
    ],
    "initialState": {
      "users": [
        {
          "id": 1,
          "email": "owner@example.com",
          "passwordHash": "x"
        },
        {
          "id": 2,
          "email": "new@example.com",
          "passwordHash": "y"
        }
      ],
      "teams": [
        {
          "id": 1,
          "name": "Acme"
        }
      ],
      "team_members": [
        {
          "id": 1,
          "userId": 1,
          "teamId": 1,
          "role": "owner"
        }
      ],
      "invitations": [
        {
          "id": 1,
          "teamId": 1,
          "email": "new@example.com",
          "role": "member",
          "invitedBy": 1,
          "status": "pending"
        }
      ],
      "activity_logs": []
    }
  },
  "actors": [
    {
      "name": "Accept1",
      "entry": {
        "selector": "src/app/actions.ts#acceptInvitation/arg[1]",
        "invocation": "awaited",
        "preconditions": [
          "authenticated-user: the session belongs to user 2 (new@example.com)",
          "validation-succeeded: invitationId is a positive integer"
        ]
      },
      "arguments": [
        {
          "invitationId": 1
        },
        null,
        {
          "id": 2,
          "email": "new@example.com"
        }
      ]
    },
    {
      "name": "Accept2",
      "entry": {
        "selector": "src/app/actions.ts#acceptInvitation/arg[1]",
        "invocation": "awaited",
        "preconditions": [
          "authenticated-user: the session belongs to user 2 (new@example.com)",
          "validation-succeeded: invitationId is a positive integer"
        ]
      },
      "arguments": [
        {
          "invitationId": 1
        },
        null,
        {
          "id": 2,
          "email": "new@example.com"
        }
      ]
    }
  ],
  "bounds": {
    "maxSteps": 40,
    "maxCrashes": 1
  },
  "invariants": [
    {
      "name": "accepted-invitation-has-membership",
      "when": "final",
      "description": "an accepted invitation always comes with the invitee's membership (the transaction is atomic, even when a process dies)",
      "assert": {
        "le": [
          {
            "count": {
              "table": "invitations",
              "where": {
                "id": 1,
                "status": "accepted"
              }
            }
          },
          {
            "count": {
              "table": "team_members",
              "where": {
                "userId": 2,
                "teamId": 1
              }
            }
          }
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../../phase7/team-app/midwrite-source.json",
    "actors": {
      "Accept1": {
        "entry": "acceptInvitation",
        "input": {
          "userId": 2,
          "form": {
            "invitationId": "1"
          }
        }
      },
      "Accept2": {
        "entry": "acceptInvitation",
        "input": {
          "userId": 2,
          "form": {
            "invitationId": "1"
          }
        }
      }
    },
    "recoveryProbe": {
      "require": [
        "blocked:Accept2",
        "crash:Accept1"
      ]
    }
  }
}