{
  "schemaVersion": 1,
  "name": "checkout-idempotent-crash-after-charge",
  "description": "FIRST-PARTY APPLICATION: the idempotent checkout under the same crash and client retry. The request id is recorded and sent as idempotency key; the provider's key deduplication is a DECLARED contract of the test double.",
  "extraction": {
    "root": "../shop-app",
    "externals": [
      {
        "callee": "chargeCard",
        "channel": "card-charge",
        "keyArgument": 1
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "card-charge": {
      "dedup": "byKey"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "orders",
        "columns": [
          "id",
          "customerEmail",
          "amount",
          "status"
        ]
      },
      {
        "from": "paymentAttempts",
        "columns": [
          "id",
          "orderId",
          "amount"
        ]
      },
      {
        "from": "idempotencyKeys",
        "columns": [
          "key",
          "orderId",
          "status"
        ]
      }
    ],
    "initialState": {
      "orders": [
        {
          "id": 1,
          "customerEmail": "c@example.com",
          "amount": 500,
          "status": "unpaid"
        }
      ],
      "payment_attempts": [],
      "idempotency_keys": []
    }
  },
  "actors": [
    {
      "name": "Client",
      "entry": {
        "selector": "src/app/checkout.ts#payOrderIdempotent",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-1",
          "orderId": 1
        }
      ],
      "retry": {
        "trigger": "onCrash"
      },
      "description": "a client that submits the same request again when the server does not answer"
    }
  ],
  "bounds": {
    "maxSteps": 40,
    "maxCrashes": 1,
    "maxRetries": 1
  },
  "invariants": [
    {
      "name": "charged-at-most-once",
      "when": "final",
      "description": "one checkout request causes at most one effective card charge",
      "assert": {
        "le": [
          {
            "externals": {
              "channel": "card-charge"
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../shop-app/midwrite-source.json",
    "actors": {
      "Client": {
        "entry": "payOrderIdempotent",
        "input": {
          "requestId": "req-1",
          "orderId": 1
        }
      }
    },
    "recoveryProbe": {
      "require": [
        "external:card-charge",
        "crash:Client",
        "retry:Client",
        "external:card-charge"
      ]
    }
  }
}