{
  "schemaVersion": 1,
  "name": "shipping-outbox-no-loss",
  "description": "FIRST-PARTY APPLICATION: the transactional outbox under a relay crash and supervisor restart: no shipped event is lost (published, or pending in the outbox). Delivery to consumers stays at-least-once.",
  "extraction": {
    "root": "../shop-app",
    "externals": [
      {
        "callee": "publishEvent",
        "channel": "order-events",
        "keyArgument": 1
      },
      {
        "callee": "sendReceiptEmail",
        "channel": "receipt-email"
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "order-events": {
      "dedup": "none"
    },
    "receipt-email": {
      "dedup": "none"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "orders",
        "columns": [
          "id",
          "customerEmail",
          "amount",
          "status"
        ]
      },
      {
        "from": "outbox",
        "columns": [
          "id",
          "topic",
          "orderId",
          "published"
        ]
      }
    ],
    "initialState": {
      "orders": [
        {
          "id": 1,
          "customerEmail": "c@example.com",
          "amount": 500,
          "status": "paid"
        }
      ],
      "outbox": []
    }
  },
  "actors": [
    {
      "name": "Shipper",
      "entry": {
        "selector": "src/app/shipping.ts#shipOrderWithOutbox",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "orderId": 1
        }
      ],
      "description": "the shipping request"
    },
    {
      "name": "Relay",
      "entry": {
        "selector": "src/app/shipping.ts#relayOutbox",
        "invocation": "awaited"
      },
      "arguments": [],
      "retry": {
        "trigger": "onCrash",
        "guaranteed": true
      },
      "description": "the outbox relay; its supervisor restarts it after a crash (declared)"
    }
  ],
  "bounds": {
    "maxSteps": 40,
    "maxCrashes": 1,
    "maxRetries": 1
  },
  "invariants": [
    {
      "name": "shipped-event-not-lost",
      "when": "final",
      "description": "every shipped order's event was published or is still pending in the outbox",
      "assert": {
        "le": [
          {
            "count": {
              "table": "orders",
              "where": {
                "status": "shipped"
              }
            }
          },
          {
            "add": [
              {
                "externals": {
                  "channel": "order-events",
                  "distinctKeys": true
                }
              },
              {
                "count": {
                  "table": "outbox",
                  "where": {
                    "published": false
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../shop-app/midwrite-source.json",
    "actors": {
      "Shipper": {
        "entry": "shipOrderWithOutbox",
        "input": {
          "orderId": 1
        }
      },
      "Relay": {
        "entry": "relayOutbox",
        "input": null
      }
    },
    "recoveryProbe": {
      "require": [
        "commit:Shipper",
        "external:order-events",
        "crash:Relay",
        "retry:Relay",
        "external:order-events"
      ]
    }
  }
}