{
  "schemaVersion": 1,
  "name": "inventory-atomic-update",
  "description": "Atomic conditional UPDATE ... WHERE stock > 0: the violation disappears under this model.",
  "extraction": {
    "root": "../project"
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "name": "products",
        "columns": [
          {
            "name": "id",
            "type": "text",
            "notNull": true
          },
          {
            "name": "stock",
            "type": "int",
            "notNull": true
          }
        ],
        "primaryKey": [
          "id"
        ]
      },
      {
        "name": "orders",
        "columns": [
          {
            "name": "id",
            "type": "text",
            "notNull": true
          },
          {
            "name": "product",
            "type": "text"
          }
        ],
        "primaryKey": [
          "id"
        ]
      }
    ],
    "initialState": {
      "products": [
        {
          "id": "product-1",
          "stock": 1
        }
      ],
      "orders": []
    }
  },
  "actors": [
    {
      "name": "A",
      "function": "purchaseAtomically",
      "file": "src/purchase.ts",
      "arguments": [
        "product-1",
        "order-A"
      ],
      "description": "one HTTP request"
    },
    {
      "name": "B",
      "function": "purchaseAtomically",
      "file": "src/purchase.ts",
      "arguments": [
        "product-1",
        "order-B"
      ],
      "description": "a concurrent HTTP request"
    }
  ],
  "bounds": {
    "maxSteps": 40,
    "maxStates": 100000
  },
  "invariants": [
    {
      "name": "successful-purchases-within-initial-stock",
      "when": "final",
      "description": "the number of successful purchases never exceeds the stock the product started with",
      "assert": {
        "le": [
          {
            "actors": {
              "function": "purchaseAtomically",
              "outcome": "ok"
            }
          },
          {
            "initial": {
              "table": "products",
              "where": {
                "id": "product-1"
              },
              "column": "stock"
            }
          }
        ]
      }
    }
  ]
}
