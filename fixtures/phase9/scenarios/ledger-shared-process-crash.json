{
  "schemaVersion": 1,
  "name": "ledger-shared-process-crash",
  "description": "FIRST-PARTY APPLICATION (fixtures/phase9/ledger-app): three requests run as concurrent tasks of ONE Node.js process that shares a connection pool of one connection. Task A is committing a payment, task B is about to publish a notification, task C waits for a connection. The process is killed with A's COMMIT in flight: every task dies together, while PostgreSQL may or may not have committed A's payment and no confirmation was published.",
  "extraction": {
    "root": "../ledger-app",
    "externals": [
      {
        "callee": "publishConfirmation",
        "channel": "confirmation"
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "confirmation": {
      "dedup": "none"
    }
  },
  "pools": {
    "P": 1
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "payments",
        "columns": [
          "id",
          "requestId",
          "orderId",
          "amount"
        ]
      }
    ],
    "initialState": {
      "payments": []
    }
  },
  "actors": [
    {
      "name": "A",
      "process": "P",
      "entry": {
        "selector": "src/app/payments.ts#recordPayment",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      ]
    },
    {
      "name": "B",
      "process": "P",
      "entry": {
        "selector": "src/app/payments.ts#notifyPayment",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-2",
          "orderId": 2,
          "amount": 500
        }
      ]
    },
    {
      "name": "C",
      "process": "P",
      "entry": {
        "selector": "src/app/payments.ts#recordPaymentAutocommit",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-3",
          "orderId": 3,
          "amount": 500
        }
      ]
    }
  ],
  "bounds": {
    "maxSteps": 60,
    "maxCrashes": 1,
    "maxInFlight": 1,
    "crashPolicy": "in-flight-only"
  },
  "invariants": [
    {
      "name": "every-recorded-payment-is-confirmed",
      "when": "final",
      "description": "each recorded payment has a confirmation (counted against the effects performed)",
      "assert": {
        "ge": [
          {
            "externals": {
              "channel": "confirmation"
            }
          },
          {
            "count": {
              "table": "payments",
              "where": {}
            }
          }
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../ledger-app/commitrift-source-pool1.json",
    "actors": {
      "A": {
        "entry": "recordPayment",
        "input": {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      },
      "B": {
        "entry": "notifyPayment",
        "input": {
          "requestId": "req-2",
          "orderId": 2,
          "amount": 500
        }
      },
      "C": {
        "entry": "recordPaymentAutocommit",
        "input": {
          "requestId": "req-3",
          "orderId": 3,
          "amount": 500
        }
      }
    }
  }
}
