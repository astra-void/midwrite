{
  "schemaVersion": 1,
  "kind": "midwrite.contracts",
  "description": "What the workspace application's source cannot say: one business rule, how clients resubmit, and how the authorized harness calls each entry.",
  "entries": {
    "src/services/workspaces.ts#addWorkspace": {
      "retry": "on-crash",
      "description": "Called by POST /api/workspaces; the client resubmits when it gets no response."
    },
    "src/services/workspaces.ts#addWorkspaceIdempotent": {
      "retry": "on-crash",
      "description": "As addWorkspace, with the request id."
    }
  },
  "invariants": [
    {
      "name": "one-workspace-per-owner",
      "description": "An owner has at most one workspace (product rule of the free plan).",
      "entries": [
        "src/services/workspaces.ts#createWorkspace",
        "src/services/workspaces.ts#createWorkspaceLocked",
        "src/services/workspaces.ts#addWorkspace",
        "src/services/workspaces.ts#addWorkspaceIdempotent",
        "src/app/actions.ts#createWorkspaceAction/arg[0]"
      ],
      "property": {
        "template": "atMostOne",
        "table": "workspaces",
        "key": ["ownerId"]
      }
    }
  ],
  "harness": {
    "manifest": "midwrite-source.json",
    "entries": {
      "src/app/actions.ts#createWorkspaceAction/arg[0]": {
        "entry": "createWorkspaceAction",
        "input": { "email": "$arg1.email", "name": "$arg0.name" }
      },
      "src/services/workspaces.ts#createWorkspace": {
        "entry": "createWorkspace",
        "input": { "ownerEmail": "$arg0", "name": "$arg1" }
      },
      "src/services/workspaces.ts#createWorkspaceLocked": {
        "entry": "createWorkspaceLocked",
        "input": { "ownerEmail": "$arg0", "name": "$arg1" }
      },
      "src/services/workspaces.ts#addWorkspace": {
        "entry": "addWorkspace",
        "input": { "ownerId": "$arg0", "name": "$arg1" }
      },
      "src/services/workspaces.ts#addWorkspaceIdempotent": {
        "entry": "addWorkspaceIdempotent",
        "input": { "requestId": "$arg0", "ownerId": "$arg1", "name": "$arg2" }
      },
      "src/services/workspaces.ts#registerUser": {
        "entry": "registerUser",
        "input": { "email": "$arg0", "name": "$arg1", "workspaceName": "$arg2" }
      },
      "src/services/invites.ts#inviteToWorkspace": {
        "entry": "inviteToWorkspace",
        "input": { "workspaceId": "$arg0", "email": "$arg1" }
      }
    }
  }
}
