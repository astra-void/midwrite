{
  "schemaVersion": 1,
  "name": "pgjs-crash-reconciled-commit-in-flight",
  "description": "FIRST-PARTY APPLICATION: after the kill the restarted client reads the ledger for its request id and records the payment only if it finds none. The COMMIT it could not see may still be on its way to the server when it reads: the read does not make the retry safe.",
  "extraction": {
    "root": "../ledger-pgjs",
    "externals": [
      {
        "callee": "publishConfirmation",
        "channel": "confirmation"
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "confirmation": {
      "dedup": "none"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "payments",
        "columns": [
          "id",
          "requestId",
          "orderId",
          "amount"
        ]
      }
    ],
    "initialState": {
      "payments": []
    }
  },
  "actors": [
    {
      "name": "Client",
      "entry": {
        "selector": "src/app/payments.ts#recordPaymentReconciled",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      ],
      "retry": {
        "trigger": "onCrash"
      },
      "description": "a client that submits the same payment again when it gets no answer"
    }
  ],
  "bounds": {
    "maxSteps": 40,
    "maxCrashes": 1,
    "maxRetries": 1,
    "maxInFlight": 1,
    "crashPolicy": "in-flight-only"
  },
  "invariants": [
    {
      "name": "recorded-at-most-once",
      "when": "final",
      "description": "one logical payment (one request id) is recorded at most once",
      "assert": {
        "le": [
          {
            "count": {
              "table": "payments",
              "where": {}
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../ledger-pgjs/commitrift-source.json",
    "actors": {
      "Client": {
        "entry": "recordPaymentReconciled",
        "input": {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      }
    }
  }
}
