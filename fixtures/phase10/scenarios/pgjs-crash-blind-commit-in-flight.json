{
  "schemaVersion": 1,
  "name": "pgjs-crash-blind-commit-in-flight",
  "description": "FIRST-PARTY APPLICATION (fixtures/phase10/ledger-pgjs (postgres-js 3.4.5)): the client sends COMMIT, the process is killed with the COMMIT in flight, the client sends the same request again. PostgreSQL may or may not have committed the first one; the client cannot tell. The blind ledger records the payment twice when it did.",
  "extraction": {
    "root": "../ledger-pgjs",
    "externals": [
      {
        "callee": "publishConfirmation",
        "channel": "confirmation"
      }
    ],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {
    "confirmation": {
      "dedup": "none"
    }
  },
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "payments",
        "columns": [
          "id",
          "requestId",
          "orderId",
          "amount"
        ]
      }
    ],
    "initialState": {
      "payments": []
    }
  },
  "actors": [
    {
      "name": "Client",
      "entry": {
        "selector": "src/app/payments.ts#recordPayment",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      ],
      "retry": {
        "trigger": "onCrash"
      },
      "description": "a client that submits the same payment again when it gets no answer"
    }
  ],
  "bounds": {
    "maxSteps": 40,
    "maxCrashes": 1,
    "maxRetries": 1,
    "maxInFlight": 1,
    "crashPolicy": "in-flight-only"
  },
  "invariants": [
    {
      "name": "recorded-at-most-once",
      "when": "final",
      "description": "one logical payment (one request id) is recorded at most once",
      "assert": {
        "le": [
          {
            "count": {
              "table": "payments",
              "where": {}
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../ledger-pgjs/midwrite-source.json",
    "actors": {
      "Client": {
        "entry": "recordPayment",
        "input": {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      }
    }
  }
}
