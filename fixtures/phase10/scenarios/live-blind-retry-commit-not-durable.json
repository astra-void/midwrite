{
  "schemaVersion": 1,
  "name": "live-blind-retry-commit-not-durable",
  "description": "FIRST-PARTY APPLICATION (fixtures/phase10/ledger-live): the COMMIT never reaches PostgreSQL (the transaction rolls back), the connection breaks, the process lives and records the payment again: the application cannot tell this from the durable case, and here the retry is right.",
  "extraction": {
    "root": "../ledger-live",
    "externals": [],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {},
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "payments",
        "columns": [
          "id",
          "requestId",
          "orderId",
          "amount"
        ]
      }
    ],
    "initialState": {
      "payments": []
    }
  },
  "actors": [
    {
      "name": "Client",
      "entry": {
        "selector": "src/app/payments.ts#recordPaymentRetryInProcess",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      ],
      "description": "a request handler whose process survives a broken database connection and retries once"
    }
  ],
  "bounds": {
    "maxSteps": 60,
    "maxCrashes": 0,
    "maxRetries": 0,
    "maxInFlight": 1
  },
  "invariants": [
    {
      "name": "recorded-at-least-once",
      "when": "final",
      "description": "the request ends up recorded (the retry did its job)",
      "assert": {
        "ge": [
          {
            "count": {
              "table": "payments",
              "where": {}
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../ledger-live/commitrift-source.json",
    "actors": {
      "Client": {
        "entry": "recordPaymentRetryInProcess",
        "input": {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      }
    },
    "recoveryProbe": {
      "require": [
        "lost-not-committed:Client"
      ]
    }
  }
}
