{
  "schemaVersion": 1,
  "name": "live-blind-retry-pool-of-one",
  "description": "FIRST-PARTY APPLICATION (fixtures/phase10/ledger-live): a connection pool of ONE connection: the broken connection is discarded and the retry obtains a new one (no starvation).",
  "extraction": {
    "root": "../ledger-live",
    "externals": [],
    "schema": "src/lib/db/schema.ts"
  },
  "channels": {},
  "database": {
    "isolation": "read-committed",
    "tables": [
      {
        "from": "payments",
        "columns": [
          "id",
          "requestId",
          "orderId",
          "amount"
        ]
      }
    ],
    "initialState": {
      "payments": []
    }
  },
  "actors": [
    {
      "name": "Client",
      "entry": {
        "selector": "src/app/payments.ts#recordPaymentRetryInProcess",
        "invocation": "awaited"
      },
      "arguments": [
        {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      ],
      "description": "a request handler whose process survives a broken database connection and retries once"
    }
  ],
  "bounds": {
    "maxSteps": 60,
    "maxCrashes": 0,
    "maxRetries": 0,
    "maxInFlight": 1
  },
  "invariants": [
    {
      "name": "recorded-at-most-once",
      "when": "final",
      "description": "one logical payment is recorded at most once",
      "assert": {
        "le": [
          {
            "count": {
              "table": "payments",
              "where": {}
            }
          },
          1
        ]
      }
    }
  ],
  "sourceVerification": {
    "harness": "../ledger-live/commitrift-source-pool1.json",
    "actors": {
      "Client": {
        "entry": "recordPaymentRetryInProcess",
        "input": {
          "requestId": "req-1",
          "orderId": 1,
          "amount": 500
        }
      }
    }
  },
  "pools": {
    "Client": 1
  }
}
