{
  "name": "@midwrite/replay",
  "version": "0.1.0",
  "private": true,
  "description": "Checkpoint client and driver adapters for Midwrite runtime replay harnesses. Not published; workspace-local until a release is authorized.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./pg": {
      "types": "./pg.d.ts",
      "default": "./pg.js"
    },
    "./event-log": {
      "types": "./event-log.d.ts",
      "default": "./event-log.js"
    },
    "./source": {
      "types": "./source.d.ts",
      "default": "./source.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "pg.js",
    "pg.d.ts",
    "event-log.js",
    "event-log.d.ts",
    "README.md",
    "source.js",
    "source.d.ts"
  ]
}
