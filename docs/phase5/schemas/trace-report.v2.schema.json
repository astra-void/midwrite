{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "commitrift.traces.v2",
  "title": "CommitRift failure trace report, schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "tool",
    "config",
    "summary",
    "traces",
    "skipped"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "commitrift.traces"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings",
        "traces",
        "complete",
        "approximated",
        "incomplete",
        "skipped"
      ],
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "traces": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "approximated": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/trace"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "code",
          "function",
          "location",
          "reason"
        ],
        "properties": {
          "findingId": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "function": {
            "type": "string"
          },
          "location": {
            "$ref": "#/definitions/location"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "location": {
      "type": "object",
      "required": [
        "file",
        "line",
        "column",
        "endLine",
        "endColumn"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer"
        },
        "endColumn": {
          "type": "integer"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "kind",
        "label",
        "description",
        "atFailure"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "dbRead",
            "dbWrite",
            "txBegin",
            "txCommit",
            "txRollback",
            "external",
            "unknown",
            "branch",
            "return",
            "unsupported"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "callChain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "callee",
              "label",
              "location"
            ],
            "additionalProperties": false,
            "properties": {
              "callee": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "location": {
                "$ref": "#/definitions/location"
              }
            }
          }
        },
        "transaction": {
          "type": "string"
        },
        "parentTransaction": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "insert",
            "update",
            "delete"
          ]
        },
        "category": {
          "type": "string"
        },
        "bestEffort": {
          "type": "boolean"
        },
        "execution": {
          "enum": [
            "awaited",
            "returned",
            "fireAndForget",
            "concurrent"
          ]
        },
        "role": {
          "enum": [
            "completedFirst",
            "notYetPerformed",
            "stagedWrite",
            "transaction",
            "inWindow"
          ]
        },
        "atFailure": {
          "enum": [
            "taken",
            "completed",
            "committed",
            "staged",
            "rolledBack",
            "performed",
            "notReached"
          ]
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "findingId",
        "code",
        "function",
        "location",
        "verification",
        "completeness",
        "steps",
        "injection",
        "simulation",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tr-[0-9a-f]{16}$"
        },
        "findingId": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}(-[0-9]+)?$"
        },
        "code": {
          "enum": [
            "CP1001",
            "CP1002",
            "CP1003",
            "CP1004",
            "CP1005",
            "MW1001",
            "MW1002",
            "MW1003",
            "MW1004",
            "MW1005"
          ]
        },
        "function": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/location"
        },
        "verification": {
          "const": "STATIC_CANDIDATE"
        },
        "completeness": {
          "enum": [
            "complete",
            "approximated",
            "incomplete"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          }
        },
        "injection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary",
            "afterStep",
            "window",
            "description",
            "checkpoints"
          ],
          "properties": {
            "boundary": {
              "enum": [
                "afterCommitBeforeExternal",
                "afterExternalBeforeCommit",
                "afterExternalInsideTransaction",
                "betweenCommits",
                "betweenExternalEffects"
              ]
            },
            "afterStep": {
              "type": "integer",
              "minimum": 0
            },
            "beforeStep": {
              "type": "integer",
              "minimum": 0
            },
            "window": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": {
              "type": "string"
            },
            "checkpoints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "step"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "step": {
                    "type": "integer"
                  },
                  "resource": {
                    "type": "string"
                  }
                }
              }
            },
            "openTransactions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "simulation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verification",
            "failureMode",
            "durable",
            "lost",
            "notPerformed",
            "claim",
            "notModeled"
          ],
          "properties": {
            "verification": {
              "const": "SIMULATED"
            },
            "failureMode": {
              "const": "processKill"
            },
            "durable": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "lost": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "notPerformed": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "claim": {
              "type": "string"
            },
            "notModeled": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "valueRelation": {
          "$ref": "#/definitions/valueRelation"
        }
      }
    },
    "valueRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "provenShared",
            "possiblyRelated",
            "noRelationEstablished",
            "provenDisjoint",
            "unknown"
          ]
        },
        "shared": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "first",
              "second"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "derivedFromResult",
                  "sameValue"
                ]
              },
              "first": {
                "type": "string"
              },
              "second": {
                "type": "string"
              },
              "exact": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  },
  "description": "Trace report schema v2 (Phase 5): v1 plus the optional per-trace `valueRelation` (how the operations around the failure boundary are related by abstract value provenance). Descriptive only. v1 reports remain valid v1 documents and are still read."
}
