/target

# trail (code-graph tool) — local setup, hooks and learnings.
/.trail/
/.claude/settings.json
/.claude/settings.local.json

# Evaluation corpus checkouts and saved binaries (see corpora/fetch.sh).
/.corpora/
/demo-output/

# JavaScript dependencies and build outputs of the fixture applications and
# generated harnesses (lockfiles are tracked), scratch output of tests, and
# local tooling caches.
node_modules/
